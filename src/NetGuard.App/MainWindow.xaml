<Window x:Class="NetGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetGuard" Width="1040" Height="760" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI" FontSize="14" Icon="Assets/netguard.ico">
    <DockPanel>
        <!-- ===== Status banner ===== -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="#2E3A46" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NETGUARD" FontSize="12" FontWeight="SemiBold" Foreground="#B9C6D2" />
                    <TextBlock x:Name="StatusTitle" Text="Loading…" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,2"/>
                    <TextBlock x:Name="StatusDetail" Text="" Foreground="#DCE4EC" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                <StackPanel x:Name="PlayPanel" Visibility="Collapsed" HorizontalAlignment="Right">
                    <TextBlock x:Name="PlayLabel" Text="Play time left" Foreground="#DCE4EC" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="PlayLeftText" Text="0:00" FontSize="40" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
                    <Button x:Name="GraceButton" Content="10 more minutes (once today)" Style="{StaticResource Secondary}" Margin="0,4,0,0" Visibility="Collapsed" Click="OnGrace"/>
                </StackPanel>
                <StackPanel x:Name="CountdownPanel" Visibility="Collapsed">
                    <TextBlock Text="Internet comes back in" Foreground="#DCE4EC" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CountdownText" Text="00:00" FontSize="40" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
                    <Button x:Name="RestoreNowButton" Content="Restore internet now" Style="{StaticResource Secondary}"
                            Margin="0,4,0,0" Click="OnRestoreNow"/>
                </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Details / output ===== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Expander x:Name="DetailsExpander" Header="Details" Padding="16,6" IsExpanded="True">
                <TextBox x:Name="Output" Height="170" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="#FAFBFC" Padding="8"/>
            </Expander>
        </Border>

        <TabControl x:Name="Tabs" Margin="18,14,18,10" Background="Transparent" BorderThickness="0">

            <!-- ===== Profiles ===== -->
            <TabItem Header="Profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,14,0,0">
                        <Border Background="#E8F3F0" CornerRadius="8" Padding="14,10" Margin="0,0,14,14">
                            <TextBlock TextWrapping="Wrap" Foreground="#24584C">
                                <Run FontWeight="SemiBold" Text="Switch"/>
                                <Run Text="starts a real lock with no end time. Stricter profiles are always one click away. Looser ones need an unlock request: a reason, a 45-minute wait, then retyping a passage – at most twice a day. Games with a play plan are available during their play time."/>
                                <LineBreak/>
                                <Run FontWeight="SemiBold" Text="Commit"/>
                                <Run Text="promises to stay in a profile (or stricter) until a time you choose – no unlock requests until then. It can be extended, never shortened."/>
                                <LineBreak/>
                                <Run FontWeight="SemiBold" Text="Test lock"/>
                                <Run Text="ends by itself after the time you choose – only possible while you have normal internet."/>
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="NoticeText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#8A4B00" Margin="0,0,14,12"/>

                        <!-- Unlock request in progress -->
                        <Border x:Name="UnlockPanel" Visibility="Collapsed" Background="#FFF6E5" BorderBrush="#E8C27A" BorderThickness="1"
                                CornerRadius="10" Padding="18" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock x:Name="UnlockTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="UnlockInfo" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{StaticResource Ink}"/>
                                <StackPanel x:Name="ConfirmArea" Visibility="Collapsed">
                                    <TextBlock Text="Type this text exactly (copying and pasting doesn't work):" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <Border Background="White" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                                        <TextBlock x:Name="PassageText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" LineHeight="22"/>
                                    </Border>
                                    <TextBox x:Name="PassageInput" Height="110" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Padding="8"
                                             AllowDrop="False" ContextMenuService.IsEnabled="False" TextChanged="OnPassageChanged"/>
                                    <TextBlock x:Name="PassageProgress" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ConfirmUnlockButton" Content="Confirm unlock" Style="{StaticResource Primary}" Click="OnConfirmUnlock"/>
                                    <Button Content="Cancel request" Style="{StaticResource Secondary}" Click="OnCancelUnlock"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="CommitButton" Content="Commit…" Style="{StaticResource Primary}" Margin="0,0,12,0" Click="OnCommit"/>
                            <TextBlock x:Name="CommitText" VerticalAlignment="Center" Margin="0,0,24,0" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Test length" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Ink}"/>
                            <ComboBox x:Name="MinutesBox" Width="130" SelectedIndex="0">
                                <ComboBoxItem Content="3 minutes" Tag="3"/>
                                <ComboBoxItem Content="5 minutes" Tag="5"/>
                                <ComboBoxItem Content="10 minutes" Tag="10"/>
                                <ComboBoxItem Content="15 minutes" Tag="15"/>
                            </ComboBox>
                        </StackPanel>
                        <UniformGrid x:Name="ProfileCards" Columns="3"/>
                        <TextBlock x:Name="NoConfigHint" Style="{StaticResource Body}" Visibility="Collapsed"
                                   Text="NetGuard isn't set up yet. Setup → Run setup wizard."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Play time ===== -->
            <TabItem x:Name="PlayTab" Header="Play time"/>

            <!-- ===== Programs ===== -->
            <TabItem x:Name="ProgramsTab" Header="Programs"/>

            <!-- ===== Setup ===== -->
            <TabItem Header="Setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,14,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Setup wizard"/>
                                <TextBlock Style="{StaticResource Body}" Text="Finds your apps, checks which programs each profile allows, creates your recovery code, and runs a one-minute recovery test."/>
                                <Button Content="Run setup wizard" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="OnRunWizard"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Recovery code"/>
                                <TextBlock Style="{StaticResource Body}" Text="Your emergency key. It's the only way to end a lock early (until the unlock process in milestone 4) and to uninstall NetGuard during a lock. It's shown exactly once: write it on paper and put it somewhere inconvenient – or give it to someone you trust. Don't keep it on this PC."/>
                                <TextBlock x:Name="RecoveryStateText" Style="{StaticResource Body}" FontWeight="SemiBold" Text=""/>
                                <Button x:Name="RecoveryButton" Content="Create recovery code" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="OnCreateRecoveryCode"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== History ===== -->
            <TabItem x:Name="HistoryTab" Header="History">
                <DockPanel Margin="4,14,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh" Style="{StaticResource Secondary}" Click="OnRefreshHistory"/>
                        <TextBlock x:Name="HistoryCount" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="6,0,0,8"/>
                    </StackPanel>
                    <ListView x:Name="HistoryList" BorderBrush="{StaticResource Line}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="When" Width="150" DisplayMemberBinding="{Binding When}"/>
                                <GridViewColumn Header="What" Width="200" DisplayMemberBinding="{Binding What}"/>
                                <GridViewColumn Header="Details" Width="520" DisplayMemberBinding="{Binding Details}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ===== Tools ===== -->
            <TabItem Header="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="4,14,0,0" ItemWidth="470">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Emergency restore"/>
                                <TextBlock Style="{StaticResource Body}" Text="Ends any lock right now and restores normal internet. Needs your recovery code while a lock is active. Every use is logged."/>
                                <Button Content="Emergency restore…" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnRecover"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Protection service"/>
                                <TextBlock x:Name="ServiceText" Style="{StaticResource Body}" Text=""/>
                                <Button x:Name="StartServiceButton" Content="Start protection service" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnStartService"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Current status"/>
                                <TextBlock Style="{StaticResource Body}" Text="Firewall settings, NetGuard's rules, and whether anything differs from the active profile."/>
                                <Button Content="Show status" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnStatus"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Find blocked programs"/>
                                <TextBlock Style="{StaticResource Body}" Text="If something that should work doesn't (e.g. Battle.net can't log in): start recording, try again, then show what was blocked."/>
                                <WrapPanel>
                                    <Button Content="Start recording" Style="{StaticResource Secondary}" Click="OnAuditOn"/>
                                    <Button Content="Stop recording" Style="{StaticResource Secondary}" Click="OnAuditOff"/>
                                    <Button Content="Show blocked (last 10 min)" Style="{StaticResource Primary}" Click="OnShowBlocked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Updates"/>
                                <TextBlock x:Name="VersionText" Style="{StaticResource Body}" Text=""/>
                                <WrapPanel>
                                    <Button Content="Check for updates" Style="{StaticResource Secondary}" Click="OnCheckUpdate"/>
                                    <Button x:Name="InstallUpdateButton" Content="Install update" Style="{StaticResource Primary}" IsEnabled="False" Click="OnInstallUpdate"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Uninstall NetGuard"/>
                                <TextBlock Style="{StaticResource Body}" Text="NetGuard protects itself, so it can only be removed from here. Restores normal internet first. Needs your recovery code while a lock is active."/>
                                <Button Content="Uninstall NetGuard…" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnUninstall"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
