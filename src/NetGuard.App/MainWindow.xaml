<Window x:Class="NetGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetGuard" Width="1100" Height="820" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI" FontSize="14" Icon="Assets/netguard.ico">
    <DockPanel>
        <!-- ===== Practice mode stripe ===== -->
        <Border x:Name="PracticeStripe" DockPanel.Dock="Top" Background="#F2C230" Padding="28,6" Visibility="Collapsed">
            <TextBlock x:Name="PracticeStripeText" FontWeight="SemiBold" Foreground="#3A2E00" TextWrapping="Wrap"/>
        </Border>

        <!-- ===== Status banner ===== -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="#2E3A46" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NETGUARD" FontSize="12" FontWeight="SemiBold" Foreground="#B9C6D2"/>
                    <TextBlock x:Name="StatusTitle" Text="Loading…" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusDetail" Text="" Foreground="#DCE4EC" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <StackPanel x:Name="PlayPanel" Visibility="Collapsed" HorizontalAlignment="Right">
                        <TextBlock x:Name="PlayLabel" Text="Play time left" Foreground="#DCE4EC" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="PlayLeftText" Text="0:00" FontSize="40" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
                        <Button x:Name="GraceButton" Content="+10 min (once today)" Style="{StaticResource Secondary}" Margin="0,4,0,0" Visibility="Collapsed" Click="OnGrace"/>
                    </StackPanel>
                    <StackPanel x:Name="WindowPanel" Visibility="Collapsed" HorizontalAlignment="Right">
                        <TextBlock x:Name="WindowLabel" Text="Bass check" Foreground="#DCE4EC" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="WindowLeftText" Text="00:00" FontSize="40" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
                        <Button Content="Close now" Style="{StaticResource Secondary}" Margin="0,4,0,0" Click="OnWindowEnd"/>
                    </StackPanel>
                    <StackPanel x:Name="CountdownPanel" Visibility="Collapsed">
                        <TextBlock Text="Internet comes back in" Foreground="#DCE4EC" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="CountdownText" Text="00:00" FontSize="40" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
                        <Button x:Name="RestoreNowButton" Content="End test lock now" Style="{StaticResource Secondary}" Margin="0,4,0,0" Click="OnRestoreNow"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Message bar (results of what you just did) ===== -->
        <Border x:Name="MessageBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="28,10" Background="#E8F3F0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnCloseMessage" Padding="6,0"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="18,14,18,10" Background="Transparent" BorderThickness="0">

            <!-- ===== Home ===== -->
            <TabItem x:Name="HomeTab" Header="Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,14,0,0">
                        <TextBlock x:Name="NoticeText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#8A4B00" Margin="0,0,14,12"/>

                        <!-- Unlock request in progress -->
                        <Border x:Name="UnlockPanel" Visibility="Collapsed" Background="#FFF6E5" BorderBrush="#E8C27A" BorderThickness="1"
                                CornerRadius="10" Padding="18" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock x:Name="UnlockTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="UnlockInfo" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{StaticResource Ink}"/>
                                <StackPanel x:Name="ConfirmArea" Visibility="Collapsed">
                                    <TextBlock Text="Type this text exactly (copying and pasting doesn't work):" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <Border Background="White" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                                        <TextBlock x:Name="PassageText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" LineHeight="22"/>
                                    </Border>
                                    <TextBox x:Name="PassageInput" Height="110" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Padding="8"
                                             AllowDrop="False" ContextMenuService.IsEnabled="False" TextChanged="OnPassageChanged"/>
                                    <TextBlock x:Name="PassageProgress" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ConfirmUnlockButton" Content="Confirm unlock" Style="{StaticResource Primary}" Click="OnConfirmUnlock"/>
                                    <Button Content="Cancel request" Style="{StaticResource Secondary}" Click="OnCancelUnlock"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,14,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UpdateButton" Content="🛠 Update &amp; shut down" Style="{StaticResource Secondary}" Margin="0,0,16,0" Click="OnUpdatesStart"
                                        ToolTip="Windows Update and Defender get internet (nothing else), NetGuard installs all updates, then shuts the PC down."/>
                                <TextBlock x:Name="WindowHintText" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <Button x:Name="WindowButton" Content="🎸 Bass check" Style="{StaticResource Secondary}" Margin="0,0,16,0" Click="OnWindowStart"/>
                                <TextBlock x:Name="CommitText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Muted}"/>
                                <Button x:Name="CommitButton" Content="Commit…" Style="{StaticResource Secondary}" Margin="0" Click="OnCommit"
                                        ToolTip="Promise to stay in a profile (or stricter) until a time you choose. Can be extended, never shortened."/>
                            </StackPanel>
                            <TextBlock Text="Profiles" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        <UniformGrid x:Name="ProfileCards" Columns="3"/>
                        <TextBlock x:Name="NoConfigHint" Style="{StaticResource Body}" Visibility="Collapsed"
                                   Text="NetGuard isn't set up yet. Settings → Run setup wizard."/>

                        <ContentControl x:Name="StatsHost" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Play time ===== -->
            <TabItem x:Name="PlayTab" Header="Play time"/>

            <!-- ===== Programs ===== -->
            <TabItem x:Name="ProgramsTab" Header="Programs"/>

            <!-- ===== History ===== -->
            <TabItem x:Name="HistoryTab" Header="History">
                <DockPanel Margin="4,14,0,0">
                    <ContentControl x:Name="SummaryHost" DockPanel.Dock="Top"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,14,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Secondary}" Margin="0" Click="OnRefreshHistory"/>
                        <TextBlock x:Name="HistoryCount" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </DockPanel>
                    <ListView x:Name="HistoryList" BorderBrush="{StaticResource Line}" MinHeight="200" Margin="0,0,14,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="When" Width="150" DisplayMemberBinding="{Binding When}"/>
                                <GridViewColumn Header="What" Width="210" DisplayMemberBinding="{Binding What}"/>
                                <GridViewColumn Header="Details" Width="560" DisplayMemberBinding="{Binding Details}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,14,0,0">
                        <WrapPanel ItemWidth="500">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Setup"/>
                                    <TextBlock Style="{StaticResource Body}" Text="Find your apps, check the programs, create your recovery code and run a one-minute recovery test."/>
                                    <Button Content="Run setup wizard" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="OnRunWizard"/>
                                    <TextBlock x:Name="RecoveryStateText" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                    <Button x:Name="RecoveryButton" Content="Create recovery code" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnCreateRecoveryCode"
                                            ToolTip="Your emergency key. Shown once – write it on paper. Only replaceable with normal internet."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Practice &amp; test"/>
                                    <TextBlock Style="{StaticResource Body}" Text="Practice mode: 30 minutes where every waiting time is short and play time counts 10× faster. Nothing counts, and normal internet comes back afterwards. Only with normal internet."/>
                                    <WrapPanel>
                                        <Button x:Name="PracticeStartButton" Content="Start practice" Style="{StaticResource Primary}" Click="OnPracticeStart"/>
                                        <Button x:Name="PracticeEndButton" Content="End practice" Style="{StaticResource Secondary}" Click="OnPracticeEnd"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,6" Text="Test lock: a profile for a few minutes, then normal internet by itself."/>
                                    <WrapPanel>
                                        <ComboBox x:Name="TestProfileBox" Width="140" Margin="0,0,8,8" VerticalContentAlignment="Center"/>
                                        <ComboBox x:Name="MinutesBox" Width="110" SelectedIndex="0" Margin="0,0,8,8" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="3 minutes" Tag="3"/>
                                            <ComboBoxItem Content="5 minutes" Tag="5"/>
                                            <ComboBoxItem Content="10 minutes" Tag="10"/>
                                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                                        </ComboBox>
                                        <Button x:Name="TestLockButton" Content="Start test lock" Style="{StaticResource Secondary}" Click="OnStartTestLock"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Emergency restore"/>
                                    <TextBlock Style="{StaticResource Body}" Text="Ends any lock right now with your recovery code. Logged. (Also in the Start menu: NetGuard Emergency Restore.)"/>
                                    <Button Content="Emergency restore…" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnRecover"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Updates"/>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Body}" Text=""/>
                                    <WrapPanel>
                                        <Button Content="Check for updates" Style="{StaticResource Secondary}" Click="OnCheckUpdate"/>
                                        <Button x:Name="InstallUpdateButton" Content="Install update" Style="{StaticResource Primary}" IsEnabled="False" Click="OnInstallUpdate"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Expander Header="Advanced" Margin="0,4,14,14" FontSize="15">
                            <WrapPanel ItemWidth="500" Margin="0,10,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Protection service"/>
                                        <TextBlock x:Name="ServiceText" Style="{StaticResource Body}" Text=""/>
                                        <WrapPanel>
                                            <Button Content="Show full status" Style="{StaticResource Secondary}" Click="OnStatus"/>
                                            <Button x:Name="StartServiceButton" Content="Start protection service" Style="{StaticResource Secondary}" Click="OnStartService"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Find blocked programs"/>
                                        <TextBlock Style="{StaticResource Body}" Text="If something that should work doesn't: start recording, try again, then show what was blocked."/>
                                        <WrapPanel>
                                            <Button Content="Start recording" Style="{StaticResource Secondary}" Click="OnAuditOn"/>
                                            <Button Content="Stop" Style="{StaticResource Secondary}" Click="OnAuditOff"/>
                                            <Button Content="Show blocked" Style="{StaticResource Secondary}" Click="OnShowBlocked"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Uninstall NetGuard"/>
                                        <TextBlock Style="{StaticResource Body}" Text="Restores normal internet first. Needs your recovery code while a lock is active."/>
                                        <Button Content="Uninstall NetGuard…" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnUninstall"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
